# .dockerignore

# Git
.git
.gitignore

# Node / pnpm
node_modules
apps/*/node_modules
.pnpm-store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python
__pycache__
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
*.egg
build/
dist/
apps/api/.venv

# IDE / OS files
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Next.js build cache/output (handled inside Dockerfile)
apps/web/.next
apps/web/out

# Environment files (copy .env.example instead)
.env
.env.*
!*.env.example

# Logs
*.log
logs

# Coverage
coverage
.coverage

# Temp files
*.tmp
*~